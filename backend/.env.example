# Copy to .env for local runs. Never commit .env.
PORT=4000
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGIN=http://localhost:3000

# Neon. DATABASE_URL: app_user on the pooled host (-pooler).
# DATABASE_URL_UNPOOLED: neondb_owner on the direct host, for migrations only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# backup_reader on the direct host; the app never reads it.
BACKUP_DATABASE_URL=

# Google Cloud OAuth web client ID (not a secret).
GOOGLE_CLIENT_ID=
# 32+ random characters; signs the app's own session tokens.
JWT_SECRET=
# Your Google account id, from GET /me after your first sign-in.
OWNER_GOOGLE_SUB=
